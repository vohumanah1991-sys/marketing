# کپی کن به .env و پر کن:  cp .env.example .env && nano .env
# .env در .gitignore است — هرگز روی گیت نمی‌رود.
# هیچ‌کدام از این کلیدها نباید در کد، فرانت‌اند، لاگ یا گیت ظاهر شوند.

ANTHROPIC_API_KEY=sk-ant-...
VOHU_MODEL=claude-sonnet-5
# VOHU_CALL_TIMEOUT_MS=180000    ← سقف هر تماس با مدل

# ── کدام سرویس؟ ─────────────────────────────────────────
# انتخاب صریح است، خودکار نیست. یک اجرا از اول تا آخر با یک سرویس
# می‌رود؛ اگر آن سرویس جواب ندهد، اجرا شکست می‌خورد و می‌گوید چرا —
# نیمه‌کاره با مدل دیگری تمام نمی‌شود.
# VOHU_PROVIDER=anthropic        ← پیش‌فرض. مقدار دیگر: openai
#
# اگر VOHU_PROVIDER=openai گذاشتی، این‌ها لازم می‌شوند:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1           ← پیش‌فرض همین است. /api/selftest می‌گوید
#                                  این مدل در حساب تو هست یا نه.
# OPENAI_BASE_URL=https://api.openai.com/v1
#                                ← اگر سرور جایی است که OpenAI مستقیم جواب
#                                  نمی‌دهد، آدرس درگاه واسط را اینجا بگذار.
#
# OPENAI_REASONING_EFFORT        ← عملاً بی‌اثر است و عمداً هم همین‌طور مانده.
#                                  کل مسیر وُهو ابزارمحور است (tools +
#                                  tool_choice اجباری) و این پارامتر فرستاده
#                                  نمی‌شود. اگر روی یک مدل استدلالی بگذاری‌اش،
#                                  سرور یک خط لاگ می‌نویسد که چرا اعمال نشد —
#                                  بی‌صدا نمی‌افتد.
#
# عوض‌کردن VOHU_PROVIDER فقط روی اجراهای **تازه** اثر دارد. اجرای نیمه‌کاره‌ای
# که با سرویس دیگری شروع شده، صریح می‌ایستد و می‌گوید باید از نو شروع کنی.

# ── اینستاگرام (اختیاری) ────────────────────────────────
# بدون APIFY_TOKEN، استخراج اینستاگرام کاملاً خاموش است و هزینه‌ای ندارد.
# APIFY_TOKEN=apify_api_...
# IG_POSTS=10                    ← چند پست در هر همگام‌سازی
# IG_REELS=10                    ← چند ریلز در هر همگام‌سازی
# IG_MAX=200                     ← سقف مطلق، حتی اگر بیشتر خواسته شود
# APIFY_COMMENTS=1               ← کامنت‌ها را هم بخواند (اکتور و هزینه‌ی جدا)
# APIFY_POLL_MS=3000             ← هر چند میلی‌ثانیه وضعیت اجرای Apify پرسیده شود
# APIFY_MAX_CALLS=0              ← سقف مطلق فراخوان در عمر پروسه (۰ = بی‌سقف). ترمز دستی هزینه.
# IG_HISTORY_TTL_H=24            ← تا این‌قدر ساعت، استخراج قبلی دوباره خوانده می‌شود نه خریده
# VOHU_STORE_DIR=.vohu           ← انبار وضعیت. اگر ندهی: .vohu — و در حالت خشک .vohu-dry
#                                  تا داده‌ی ساختگی وارد تاریخچه‌ی واقعی نشود
#
# خواندن اینستاگرام مهلت ندارد — ریلز دقیقه‌ها طول می‌کشد و قطع‌کردنش یعنی
# هزینه‌ی Apify خرج شده بدون هیچ شاهدی. به‌جای مهلت، پیشرفت واقعی نشان داده می‌شود.
# این دو فقط اگر صریح تعریفشان کنی مهلت می‌گذارند (و اجرا را روی Apify هم قطع می‌کنند):
# APIFY_TIMEOUT_MS=240000        ← سقف استخراج عمیق
# IG_QUICK_TIMEOUT_MS=60000      ← سقف خواندن سریع در مرحله‌ی اول
# APIFY_ACTOR_POSTS=apify~instagram-scraper
# APIFY_ACTOR_REELS=apify~instagram-reel-scraper
# APIFY_ACTOR_COMMENTS=apify~instagram-comment-scraper

# ── اختیاری ─────────────────────────────────────────────
# PORT=3000
# HOST=0.0.0.0
# VOHU_DRY_RUN=1                 ← بدون تماس با مدل، از fixtures می‌خواند
